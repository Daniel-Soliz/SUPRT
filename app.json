{
  "expo": {
    "name": "SUPRT",
    "slug": "suprt",
    "scheme": "suprt",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.suprt.app"
    },
    "android": {
      "package": "br.com.suprt.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "name": "SUPRT"
    },
    "experiments": {
      "baseUrl": "/SUPRT"
    },
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permita que o SUPRT use sua localização para identificar onde está o veículo ao pedir ajuda.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
